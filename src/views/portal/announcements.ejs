<div class="page-title">
  <div><h1><%= t('portal.announcements') %></h1><p><%= t('pt.announcementsLead') %></p></div>
</div>

<nav class="tabs" aria-label="<%= t('pt.categories') %>">
  <a href="/portal/announcements"<%- !cat ? ' aria-current="page"' : '' %>><%= t('common.all') %></a>
  <% cats.forEach(c => { %><a href="/portal/announcements?cat=<%= c %>"<%- cat === c ? ' aria-current="page"' : '' %>><%= t('annCat.' + c) %></a><% }) %>
</nav>

<% if (!items.length) { %>
  <%- include('../partials/empty', { emptyIcon: 'bell', emptyTitle: t('pt.noAnnouncements'), emptyText: t('common.noResultsHint') }) %>
<% } %>
<% (cat ? [cat] : cats).forEach(c => { const list = items.filter(a => a.category === c); if (!list.length) return; %>
  <section class="mb-3" aria-labelledby="cat-<%= c %>">
    <h2 id="cat-<%= c %>" class="mb-2" style="font-size:1.15rem"><%- icon('bell') %> <%= t('annCat.' + c) %></h2>
    <div class="stack">
      <% list.forEach(a => { %>
        <article class="card" id="a<%= a.id %>">
          <div class="row-between">
            <h3 style="font-size:1.02rem"><%= L(a, 'title') %></h3>
            <span class="small muted nowrap"><%- icon('calendar') %> <%= fmt.date(a.publish_from || a.created_at) %></span>
          </div>
          <% if (L(a, 'body')) { %><p class="mb-0" style="white-space:pre-line"><%= L(a, 'body') %></p><% } %>
          <% if (a.link_url) { %><a class="link-arrow small" href="<%= a.link_url %>"<%- /^https?:/i.test(a.link_url) ? ' target="_blank" rel="noopener"' : '' %>><%= t('common.viewDetails') %> <%- icon(/^https?:/i.test(a.link_url) ? 'external' : 'arrow') %></a><% } %>
        </article>
      <% }) %>
    </div>
  </section>
<% }) %>
