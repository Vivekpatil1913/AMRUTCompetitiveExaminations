<%# Test table. expects: tests (rows from TEST_SQL) %>
<% if (!tests.length) { %>
  <%- include('../partials/empty', { emptyIcon: 'test', emptyTitle: t('pt.noTests'), emptyText: t('pt.noTestsHint') }) %>
<% } else { const pk = (r, a, b) => (lang === 'mr' && r[b]) ? r[b] : r[a]; %>
  <div class="table-wrap">
    <table class="table table-stack">
      <caption class="sr-only"><%= t('portal.tests') %></caption>
      <thead><tr>
        <th scope="col"><%= t('pt.test') %></th><th scope="col"><%= t('common.type') %></th><th scope="col"><%= t('pt.linkedLecture') %></th>
        <th scope="col"><%= t('common.subject') %></th><th scope="col"><%= t('pt.questions') %></th><th scope="col"><%= t('pt.lastResult') %></th>
        <th scope="col"><span class="sr-only"><%= t('pt.actions') %></span></th>
      </tr></thead>
      <tbody>
        <% tests.forEach(tt => { %>
          <tr>
            <td data-label="<%= t('pt.test') %>"><strong><%= L(tt, 'title') %></strong></td>
            <td data-label="<%= t('common.type') %>"><span class="badge badge-brand"><%= t('pt.testType.' + tt.test_type) %></span></td>
            <td data-label="<%= t('pt.linkedLecture') %>"><% if (tt.lecture_id) { %><a href="/portal/lectures/<%= tt.lecture_id %>"><%= pk(tt, 'lecture_en', 'lecture_mr') %></a><br><span class="small muted"><%= fmt.date(tt.lecture_date) %></span><% } else { %>—<% } %></td>
            <td data-label="<%= t('common.subject') %>"><%= pk(tt, 'subject_en', 'subject_mr') || '—' %></td>
            <td data-label="<%= t('pt.questions') %>"><%= tt.q_count %></td>
            <td data-label="<%= t('pt.lastResult') %>"><% if (tt.last_attempt_id) { %><a href="/portal/attempts/<%= tt.last_attempt_id %>/result"><%= tt.last_correct %> / <%= tt.last_total %></a><br><span class="small muted"><%= fmt.datetime(tt.last_submitted) %></span><% } else { %><span class="muted"><%= t('pt.notAttempted') %></span><% } %></td>
            <td data-label="<%= t('pt.actions') %>" class="actions"><a class="btn btn-primary btn-sm" href="/portal/tests/<%= tt.id %>"><%= t('pt.openTest') %></a></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } %>
