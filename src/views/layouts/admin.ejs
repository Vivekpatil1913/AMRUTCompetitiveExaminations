<!doctype html>
<html lang="en">
<head>
<%- include('../partials/head') %>
<meta name="robots" content="noindex">
</head>
<body class="admin">
<%
  const groupOrder = ['Candidates', 'Academic Structure', 'Offline Training', 'Lectures & Schedules', 'Tests & Assessment', 'Learning Resources', 'Communication', 'Website'];
  const custom = {
    'Candidates': [['/admin/candidates', 'users', 'Users / Candidates'], ['/admin/candidates?verification=pending', 'shield', 'Verification (pending)']],
    'Offline Training': [['/admin/bookings', 'bed', 'Offline Bookings'], ['/admin/bookings?tab=proofs', 'upload', 'Payments / Transaction Proofs'], ['/admin/bookings?tab=refunds', 'rupee', 'Refunds']],
    'Lectures & Schedules': [['/admin/timetable', 'calendar', 'Timetable']],
    'Website': [['/admin/settings?group=general', 'settings', 'General, Logo & Favicon'], ['/admin/settings?group=footer', 'grid', 'Footer'], ['/admin/settings?group=integration', 'link', 'Mahaamrut Integration'], ['/admin/settings?group=payment', 'rupee', 'Payment Settings'], ['/admin/roles', 'shield', 'Admin Roles (HOLD)']],
  };
  const cur = (href) => { const [p, q] = href.split('?'); return url === href || (!q && (path === p || path.startsWith(p + '/')) && !url.includes('?verification') && !url.includes('?tab=') && !url.includes('?group=')); };
%>
<%- include('../partials/topbar') %>
<div class="portal-bar">
  <div class="container">
    <div class="row" style="flex-wrap:nowrap;min-width:0">
      <button class="btn btn-secondary btn-sm sidebar-toggle" type="button" data-sidebar-toggle aria-controls="admin-sidebar" aria-expanded="false"><%- icon('menu') %><span class="sr-only">Menu</span></button>
      <a class="brand" href="/admin"><img class="emblem" src="<%= S('emblem') %>" alt="" width="26" height="44"><img class="logo" src="<%= S('logo') %>" alt="AMRUT" width="110" height="26"><span class="titles"><span class="prog">Admin Panel</span><span class="org"><%= S('site_title') %></span></span></a>
    </div>
    <div class="row">
      <a class="btn btn-ghost btn-sm" href="/" target="_blank" rel="noopener"><%- icon('external') %> <span class="hide-sm">View website</span></a>
      <% if (admin) { %><form method="post" action="/admin/logout"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-on-dark btn-sm" type="submit"><%- icon('logout') %> Logout</button></form><% } %>
    </div>
  </div>
</div>
<div class="shell">
  <aside class="sidebar" id="admin-sidebar" aria-label="Admin navigation">
    <div class="who"><span class="avatar"><%= admin ? admin.name.charAt(0) : 'A' %></span><div><div class="name"><%= admin ? admin.name : '' %></div><div class="id"><%= admin ? admin.email : '' %></div></div></div>
    <ul class="sidenav">
      <li><a href="/admin"<% if (path === '/admin' || path === '/admin/') { %> aria-current="page"<% } %>><%- icon('grid') %>Dashboard</a></li>
      <% groupOrder.forEach(g => { const items = (custom[g] || []).concat(adminResources.filter(r => r.group === g).map(r => ['/admin/' + r.key, r.icon, r.title])); %>
        <li class="group"><%= g %></li>
        <% items.forEach(([href, ic, label]) => { %><li><a href="<%= href %>"<% if (cur(href)) { %> aria-current="page"<% } %>><%- icon(ic) %><%= label %></a></li><% }) %>
      <% }) %>
    </ul>
  </aside>
  <main id="main" class="shell-main" tabindex="-1">
    <% if (flash) { %><div class="mb-2"><%- include('../partials/flash') %></div><% } %>
    <%- body %>
  </main>
</div>
<script src="/js/app.js" defer></script>
</body>
</html>
