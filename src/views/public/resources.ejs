<%- include('../partials/page-header', { lead: t('home.resSub') }) %>
<section class="section">
  <div class="container">
    <nav class="tabs" aria-label="<%= t('nav.resources') %>">
      <a href="/resources<%= qs(f, { type: '' }) %>"<% if (!f.type) { %> aria-current="page"<% } %>><%= t('common.all') %></a>
      <% types.forEach(k => { %><a href="/resources<%= qs(f, { type: k }) %>"<% if (f.type === k) { %> aria-current="page"<% } %>><%= t('resourceType.' + k) %> <span class="muted small">(<%= counts[k] || 0 %>)</span></a><% }) %>
    </nav>
    <form class="filters" method="get" action="/resources">
      <% if (f.type) { %><input type="hidden" name="type" value="<%= f.type %>"><% } %>
      <div class="field"><label for="f-exam"><%= t('common.exam') %></label>
        <select class="select" id="f-exam" name="exam"><option value=""><%= t('common.all') %></option><% opts.exams.forEach(o => { %><option value="<%= o.id %>"<%= String(f.exam) === String(o.id) ? ' selected' : '' %>><%= L(o, 'name') %></option><% }) %></select></div>
      <div class="field"><label for="f-course"><%= t('common.course') %></label>
        <select class="select" id="f-course" name="course"><option value=""><%= t('common.all') %></option><% opts.courses.forEach(o => { %><option value="<%= o.id %>"<%= String(f.course) === String(o.id) ? ' selected' : '' %>><%= L(o, 'title') %></option><% }) %></select></div>
      <div class="field"><label for="f-subject"><%= t('common.subject') %></label>
        <select class="select" id="f-subject" name="subject"><option value=""><%= t('common.all') %></option><% opts.subjects.forEach(o => { %><option value="<%= o.id %>"<%= String(f.subject) === String(o.id) ? ' selected' : '' %>><%= o.short_name ? o.short_name + ' – ' : '' %><%= L(o, 'name') %></option><% }) %></select></div>
      <div class="field"><label for="f-topic"><%= t('common.topic') %></label>
        <select class="select" id="f-topic" name="topic"><option value=""><%= t('common.all') %></option><% opts.topics.forEach(o => { %><option value="<%= o.id %>"<%= String(f.topic) === String(o.id) ? ' selected' : '' %>><%= L(o, 'name') %></option><% }) %></select></div>
      <div class="actions"><button class="btn btn-primary" type="submit"><%- icon('search') %> <%= t('common.apply') %></button><a class="btn btn-ghost" href="/resources<%= f.type ? '?type=' + f.type : '' %>"><%= t('common.reset') %></a></div>
    </form>
    <% if (!candidate) { %><div class="alert alert-info mb-2"><%- icon('lock') %><p><%= lang === 'mr' ? 'काही संसाधने केवळ नोंदणीकृत / पडताळणी झालेल्या उमेदवारांसाठी आहेत. सर्व यूट्यूब साहित्य खासगी नाही.' : 'Some resources are for registered / verified candidates only. Not all YouTube content is private.' %> <a href="/login"><%= t('nav.login') %></a></p></div><% } %>
    <% if (rows.length) { %>
      <div class="grid grid-3"><% rows.forEach(r => { %><%- include('../partials/resource-card', { r }) %><% }) %></div>
    <% } else { %><%- include('../partials/empty', { emptyIcon: 'book' }) %><% } %>
  </div>
</section>
