<%- include('../partials/page-header', { crumbs: [[t('login.title'), '/login']], lead: L({ title_en: 'Help with candidate login', title_mr: 'उमेदवार लॉगिनसाठी मदत' }, 'title') }) %>
<section class="section-sm">
  <div class="container" style="max-width:820px">
    <div class="stack">
      <div class="alert alert-info"><%- icon('info') %><p><%= S('login_help') %></p></div>
      <%- include('../partials/hold', { holdTitle: t('hold.label'), holdItems: [
        lang === 'mr' ? 'पासवर्ड विसरल्यास / रीसेट प्रक्रिया – महाअमृत प्रमाणीकरण निश्चित झाल्यावर' : 'Forgot / reset password process – depends on the final Mahaamrut authentication method',
        lang === 'mr' ? 'OTP लॉगिन – SMS सेवा प्रदाता निश्चित नाही' : 'OTP login – SMS provider not finalised',
      ] }) %>
      <div class="card">
        <h3><%- icon('user') %> <%= t('footer.contact') %></h3>
        <dl class="dl">
          <dt><%= lang === 'mr' ? 'दूरध्वनी' : 'Phone' %></dt><dd><a href="tel:<%= S('footer_phone').replace(/\s/g,'') %>"><%= S('footer_phone') %></a></dd>
          <dt><%= lang === 'mr' ? 'ईमेल' : 'Email' %></dt><dd><a href="mailto:<%= S('footer_email') %>"><%= S('footer_email') %></a></dd>
          <dt><%= lang === 'mr' ? 'महाअमृत पोर्टल' : 'Mahaamrut portal' %></dt><dd><a href="<%= S('mahaamrut_portal_url') %>" target="_blank" rel="noopener"><%= S('mahaamrut_portal_url') %></a></dd>
        </dl>
      </div>
      <div class="row"><a class="btn btn-primary" href="/login"><%- icon('login') %> <%= t('login.title') %></a><a class="btn btn-ghost" href="/"><%= t('login.back') %></a></div>
    </div>
  </div>
</section>
