<% if (flash) { %>
  <div class="alert alert-<%= flash.type %>" role="<%= flash.type === 'error' || flash.type === 'danger' ? 'alert' : 'status' %>">
    <%- icon(flash.type === 'success' ? 'check' : flash.type === 'error' || flash.type === 'danger' ? 'alert' : 'info') %><p><%= flash.msg %></p>
  </div>
<% } %>
